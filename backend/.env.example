PORT=5001

# Database — either DB_URL or individual credentials
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=
DB_PASSWORD=
DB_NAME=spendly
# DB_URL=postgresql://user:password@localhost:5432/spendly

FRONTEND_URL=http://localhost:8081

JWT_SECRET=change_me_to_a_strong_random_string_32_chars
REFRESH_SECRET=change_me_to_another_strong_random_string

# Time-based access key: valid key = PREFIX + HH + MM (IST) + SUFFIX
PREFIX=01
SUFFIX=11
APP_ACCESS_KEY=

# AI image parsing (Google Gemini Flash — free tier)
# Get your key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# WebAuthn (biometric unlock for cashback view). Optional — defaults to the
# hostname of FRONTEND_URL. Only needs setting explicitly if that derivation
# doesn't match where the frontend is actually served from.
# WEBAUTHN_RP_ID=spendly.example.com

# Google Drive backup (Backup & restore page). Create an OAuth client at console.cloud.google.com
# (APIs & Services → Credentials → Web application) with this redirect URI:
#   <BACKEND_URL>/api/v1/backup-hooks/drive-callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Public address of this backend (no trailing slash), e.g. https://spendly-api.onrender.com
BACKEND_URL=http://localhost:5001
# 16+ random characters: encrypts the stored Google key. Changing it means reconnecting Drive.
BACKUP_SECRET=
# 16+ random characters: shared key the daily scheduler sends in the x-backup-key header.
BACKUP_CRON_KEY=
